# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# DropSync shared files storage (do not commit uploaded files)
shared_data/*
!shared_data/.gitkeep

# PyInstaller build output (distribute via GitHub Releases, not git)
dist/
build/
*.spec.bak

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
*.log
